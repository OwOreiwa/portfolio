---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Navigation from '../components/Navigation.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style is:global>
			.hero-image {
				display: flex;
				flex-direction: column;
				justify-content: center;
				max-height: 50vh;
				position: relative;

				img {
					position: absolute;
					top: 0;
					z-index: -1;
				}
				
				.header {
					margin-left: 10%;

					.title {
						font-size: 4em;
						color: rgb(var(--base-comp-1));
						margin: 0;
					}
					.date {
						font-size: 1em;
						color: rgb(var(--base-comp-4));
						margin: 0;
					}
					.last-updated-on {
						color: rgb(var(--base-comp-5));
						font-style: italic;
						white-space: nowrap;
						position: absolute;
						left: 12%;
					}
				}
			}
			/*
			.hero-image::before {
				content: "";
				position: absolute;
				width: 100%;
				height: 100%;
				background: linear-gradient(rgba(var(--base-comp-3), 0.5), rgba(var(--base-satu), 0.75));
			}
			*/

			.prose {
				padding: 72px 0;
			}

			@media screen and (max-width: 959px) {
				.hero-image {
					.header {
						.title {
							font-size: 2em;
						}
						.date {
							font-size: 0.8em;
						}
						.last-updated-on {
							font-size: 0.8em;
						}
					}
				}

				.prose {
					padding: 36px 0;
				}
			}
		</style>
	</head>

	<body>
		<Navigation />
		<main>
			<article>
				<div class="hero-image image-wider">
					{heroImage && <Image src={heroImage} alt="" />}
					<div class="header">
						<h1 class="title">{title}</h1>
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
	</body>
</html>
