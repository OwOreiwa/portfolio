---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Navigation from '../../components/Navigation.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style lang="scss">
			main {
				margin-left: 20vw;
			}

			h1 {
				line-height: 1;
				padding: 3vh 0;
				color: rgb(var(--base-comp-5));
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				list-style-type: none;
				margin: 0;
				padding: 0;

				li {
					width: 100%;
					height: 6rem;

					* {
						text-decoration: none;
						transition: 0.2s ease;
					}

					a {
						display: flex;
					}

					border-bottom: 1px solid rgba(var(--base-comp-5), 0.25);
					&:first-child {
						border-top: 1px solid rgba(var(--base-comp-5), 0.25);
					}
				}
			}

			.post-image {
				width: 30%;
				min-width: 30%;

				img {
					width: 100%;
					height: 6rem;
					vertical-align: top;
					object-fit: cover;
				}
			}
			
			.post-label {
				display: flex;
				justify-content: space-between;
				align-items: center;
				width: stretch;
				margin: auto;
				padding: 0 2vw;
				transform: translateY(0.1em);

				.post-title {
					margin: 0;
					font-size: 2.369rem;
					color: rgb(var(--base-comp-1));
					line-height: 1;
					white-space: nowrap;

					a:hover & {
						color: rgb(var(--accent));
					}
				}
				.post-date {
					margin: 0;
					color: rgb(var(--base-comp-3));
					line-height: 1;

					a:hover & {
						color: rgb(var(--accent));
					}
				}
			}

			@media screen and (max-width: 959px) {
				main {
					margin-left: 0;
				}

				h1 {
					font-size: 1rem;
					margin: 0;
					padding: 3vh 8vw;
				}

				ul {
					li {
						height: 4rem;

						a {
							flex-direction: row-reverse;
							height: 100%;
							padding: 0 8vw;
						}
					}
				}

				.post-image {
					position: absolute;
					height: 4rem;

					img {
						height: 100%;
					}
				}

				.post-label {
					display: flex;
					flex-direction: column;
					align-items: flex-start;
					padding: 0;
					
					.post-title {
						font-size: 1rem;
					}
				}
			}
		</style>
	</head>
	<body>
		<Navigation />
		<main>
			<section>
				<h1>Blog Posts, Breakdowns, <br>and Guides</h1>
			</section>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`}>
									{post.data.heroImage && (
										<div class="post-image">
											<Image src={post.data.heroImage} alt="" />
										</div>
									)}
									<div class="post-label">
										<h4 class="post-title">{post.data.title}</h4>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
	</body>
</html>
